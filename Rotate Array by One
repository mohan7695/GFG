class Solution {
    public void rotate(int[] arr) {
        // code here
        int n=arr.length;
        
        int[] nums=new int[n];
        nums[0]=arr[n-1];
     int count=0;
     for(int i=1;i<n;i++){
         nums[i]=arr[count++];
     }   
     for(int i=0;i<n;i++){
         arr[i]=nums[i];
     }
    }
}
