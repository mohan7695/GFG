class Solution {
    public ArrayList<Integer> kLargest(int[] arr, int k) {
        // code here
        PriorityQueue<Integer> pq =new PriorityQueue<>(Collections.reverseOrder());
        for(int n : arr){
            pq.add(n);
        }
        
        ArrayList<Integer> list = new ArrayList<>();
        int i=0;
      while(i<k){
          
            list.add(pq.remove());
            i++;
        }
        return list;
    }
}
