class Solution {
    public static int countPairs(int arr[], int k) {
        // code here
      Arrays.sort(arr);
        int count=0;
        int i=0;
        int j=1;
        
        while( j< arr.length){
            
            if(arr[j] -arr[i] <k ){
                count+=(j-i);
                j++;
                //i++;
            }
           else {
               i++;
               
           }
           
           if(i==j) j++;
          
        }
        return count;
       
    }
}
