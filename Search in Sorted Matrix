class Solution {
    public boolean searchMatrix(int[][] mat, int x) {
        // code here
        int left = mat.length;
        int right = mat[0].length;
        int l = 0;
        int r = left*right-1;
        while(l <= r){
            int mid = l+ (r-l)/2;
            int row = mid/right;
            int col = mid%right;
            
            if(mat[row][col] == x){
                return true;
            }
            else if(mat[row][col] < x){
                l = mid+1;
            }
            else{
                r = mid-1;
            }
        }
        return false;
    }
}
