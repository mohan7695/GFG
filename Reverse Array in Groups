class Solution {
    public void kelements(int[] arr,int k){
      
      for(int i=0;i < arr.length;i+=k){
          
            int temp=i;
            
            int mins=Math.min(i+k-1,arr.length-1);
            
            while(temp < mins){
                swap(arr,temp++,mins--);
            }
          
      }
    }
    static int[] swap(int[] nums,int i,int j){
       int temp=nums[i];
       nums[i]=nums[j];
       nums[j]=temp;
        
        return nums;
    }
    public void reverseInGroups(int[] arr, int k) {
        // code here
       kelements(arr,k);
      
        
    }
}
