class Solution {
	static int isSumPalindrome(int n) {
		
		long k = n;
		
		long temp = n;
		long reverse = 0;
		
		while (temp > 0) {
			reverse = (reverse * 10) + (temp % 10);
			temp /= 10;
		}
		
		if (n == reverse) {
			return (int) k;
		}
		
		for (int i = 0; i < 5; i++) {
			
			temp = k;
			reverse = 0;
			
			while (temp > 0) {
				reverse = (reverse * 10) + (temp % 10);
				temp /= 10;
			}
			
			k = k + reverse;
			
			temp = k;
			long check = 0;
			
			while (temp > 0) {
				check = (check * 10) + (temp % 10);
				temp /= 10;
			}
			
			if (k == check) {
				return (int) k;
			}
		}
		
		return - 1;
	}
}
