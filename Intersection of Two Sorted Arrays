class Solution {
    ArrayList<Integer> intersection(int[] a, int[] b) {
        // code here
        HashSet<Integer> list  = new LinkedHashSet<>();
        
        for(int n : a){
            list.add(n);
        }
        
       
          HashSet<Integer> set1  = new LinkedHashSet<>();
        for(int k : b){
            if(list.contains(k)){
                set1.add(k);
            }
        }
         ArrayList<Integer> set= new ArrayList<>(set1);
        return set;
    }
}
