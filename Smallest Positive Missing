class Solution {
    public int missingNumber(int[] arr) {
        
int max =0;
HashSet<Integer> set =new HashSet<>();
Arrays.sort(arr);
for(int k : arr){
    if(k >0){
          
        
    set.add(k);
    max=Math.max(max,k);
    }
}
for(int i=1;i <= max;i++){
    
        
            
            if(!set.contains(i)){
                return i;
            }
            
        
}
return max+1;
        
    }
}
