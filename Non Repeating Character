class Solution {
    public char nonRepeatingChar(String s) {
        // code here
        int[] arr=new int[26];
        
        for(char ch :s.toCharArray()){
            arr[ch-'a']++;
            
        }
        
        for(char i :s.toCharArray()){
            if(arr[ i -'a'] == 1){
                
                
                return i;
            }
        }
        return '$';
        
    }
}
